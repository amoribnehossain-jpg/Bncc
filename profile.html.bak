<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cadet Profile | BMARPC Air Wing</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Open+Sans:wght@400;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --primary: #2c3e50;
      --primary-light: #34495e;
      --primary-dark: #1a2530;
      --accent: #3498db;
      --accent-hover: #2980b9;
      --accent-dark: #16a085;
      --bg: #f8f9fa;
      --bg-light: #e9ecef;
      --white: #ffffff;
      --text: #2c3e50;
      --text-muted: #6c757d;
      --border: #dee2e6;
      --radius: 12px;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Open Sans', sans-serif;
      background: linear-gradient(rgba(0,0,0,0.3), rgba(0,0,0,0.2)),
                  url('images/hero-jets.jpeg') center center no-repeat;
      background-size: cover;
      background-attachment: fixed;
      color: var(--text);
      min-height: 100vh;
      padding: 1.5rem;
    }
    .profile-container {
      max-width: 900px;
      margin: 4rem auto;
      padding: 1.5rem;
    }
    .profile-header {
      text-align: center;
      margin-bottom: 3rem;
    }
    .profile-header h1 {
      font-family: 'Montserrat', sans-serif;
      font-size: 2.2rem;
      color: var(--text);
      font-weight: 700;
      margin-bottom: 0.75rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
    }
    .profile-header p {
      color: #446280;
      font-size: 1.1rem;
      font-weight: 500;
    }
    .profile-card {
      background: var(--white);
      border-radius: var(--radius);
      box-shadow: 0 25px 60px rgba(0,0,0,0.08);
      border: 1px solid var(--border);
      overflow: hidden;
    }
    .rank-badge {
      background: linear-gradient(135deg, var(--primary), var(--primary-light));
      color: var(--white);
      font-family: 'Montserrat', sans-serif;
      font-size: 1.4rem;
      font-weight:700;
      padding: 1.25rem 2.5rem;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      border-radius: 0 0 var(--radius) var(--radius);
      margin-bottom: 1.5rem;
      box-shadow: 0 4px 15px rgba(0,0,0,0.15);
    }
    .profile-photo-section {
      display: flex;
      justify-content: center;
      padding: 2rem 0 1.5rem;
      background: var(--bg-light);
    }
    .profile-photo-section img {
      width: 140px;
      height: 140px;
      object-fit: cover;
      border-radius: 50%;
      border: 4px solid var(--accent);
      box-shadow: 0 8px 25px rgba(0,0,0,0.15);
      transition: transform 0.3s ease;
    }
    .profile-photo-section img:hover {
      transform: scale(1.05);
    }
    .profile-details {
      padding: 2.5rem;
    }
    .cv-section {
      margin-bottom: 2.5rem;
    }
    .cv-section h3 {
      font-family: 'Montserrat', sans-serif;
      font-size: 1.35rem;
      color: var(--primary);
      padding-bottom: 0.75rem;
      border-bottom: 2px dashed var(--border);
      margin-bottom: 1.5rem;
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .cv-section h3 i {
      color: var(--accent);
      font-size: 1.2rem;
    }
    .cv-row {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 1.5rem;
    }
    .cv-item {
      display: flex;
      flex-direction: column;
      min-width: 150px;
    }
    .cv-label {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 0.3rem;
      font-weight: 600;
    }
    .cv-value {
      font-family: 'Montserrat', sans-serif;
      font-size: 1.15rem;
      color: var(--text);
      font-weight: 600;
    }
    .real-time-status {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 2rem;
      margin-top: 1.5rem;
      padding: 1.5rem;
      background: var(--bg-light);
      border-radius: var(--radius);
    }
    .status-item {
      text-align: center;
    }
    .status-item i {
      font-size: 1.5rem;
      color: var(--accent);
      margin-bottom: 0.5rem;
      display: block;
    }
    .status-item p {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin: 0;
    }
    .status-indicator {
      display: inline-block;
      width: 10px;
      height: 10px;
      background: var(--accent);
      border-radius: 50%;
      animation: pulse 2s infinite;
      margin-right: 8px;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.6; }
    }
    .last-updated {
      text-align: center;
      color: var(--text-muted);
      font-size: 0.9rem;
      margin-top: 2rem;
      padding-top: 1rem;
      border-top: 1px solid var(--border);
    }
    .logout-btn {
      display: block;
      margin: 3rem auto 0;
      padding: 0.95rem 2.75rem;
      background: linear-gradient(135deg, var(--primary), var(--primary-light));
      color: var(--accent);
      border: none;
      border-radius: var(--radius);
      font-weight: 600;
      font-family: 'Montserrat', sans-serif;
      font-size: 1.05rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      text-align: center;
      box-shadow: 0 4px 15px rgba(44, 62, 80, 0.25);
    }
    .logout-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 20px rgba(44, 62, 80, 0.35);
    }
    .logout-btn i {
      margin-right: 0.5rem;
    }
    @media (max-width: 768px) {
      .profile-container {
        margin: 2rem auto;
      }
      .profile-card {
        border-radius: var(--radius);
      }
      .profile-details {
        padding: 2rem;
      }
      .rank-badge {
        font-size: 1.2rem;
        padding: 1rem 2rem;
      }
      .cv-row {
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }
      .cv-value {
        font-size: 1rem;
      }
    }
    @media (max-width: 480px) {
      .profile-container {
        margin: 1.5rem auto;
        padding: 1rem;
      }
      .profile-photo-section {
        padding: 1.25rem 0 1rem;
      }
      .profile-details {
        padding: 1.5rem;
      }
      .profile-header h1 {
        font-size: 1.8rem;
      }
      .profile-header p {
        font-size: 0.95rem;
      }
      .cv-row {
        grid-template-columns: 1fr;
        gap: 1rem;
      }
      .rank-badge {
        font-size: 1.1rem;
        padding: 0.85rem 1.75rem;
      }
      .cv-section h3 {
        font-size: 1.25rem;
        padding-bottom: 0.5rem;
        margin-bottom: 1rem;
      }
      .logout-btn {
        margin: 2.5rem auto 0;
        padding: 0.85rem 2.5rem;
        font-size: 1rem;
      }
    }

    @media (max-width: 360px) {
      .profile-container {
        margin: 1rem auto;
        padding: 0.75rem;
      }
      .profile-details {
        padding: 1.25rem;
      }
      .profile-photo-section {
        padding: 1rem 0 0.75rem;
      }
      .rank-badge {
        font-size: 1rem;
        padding: 0.75rem 1.5rem;
      }
      .logout-btn {
        padding: 0.8rem 2.25rem;
        font-size: 0.95rem;
      }
      .real-time-status {
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1rem;
      }
      .status-item {
        flex: 1 1 100px;
      }
    }
  </style>
</head>
<body>
  <div class="profile-container">
    <div class="profile-header">
      <h1><i class="fas fa-crown"></i> Cadet Portal</h1>
      <p>Welcome to your BMARPC Air Wing profile</p>
    </div>
    <div class="profile-card">
      <div class="rank-badge" id="profileBadge">
        <i class="fas fa-star"></i> Cadet
      </div>
      <div class="profile-photo-section" id="profilePhotoSection">
        <img id="profilePhoto" src="" alt="Profile Photo">
      </div>
      <div class="profile-details">
        <div class="cv-section">
          <h3><i class="fas fa-user-shield"></i> Personal Information</h3>
          <div class="cv-row">
            <div class="cv-item">
              <div class="cv-label">Full Name</div>
              <div class="cv-value" id="profileName">-</div>
            </div>
            <div class="cv-item">
              <div class="cv-label">Cadet No.</div>
              <div class="cv-value" id="profileCadetNo">-</div>
            </div>
            <div class="cv-item">
              <div class="cv-label">Sex</div>
              <div class="cv-value" id="profileSex">-</div>
            </div>
            <div class="cv-item">
              <div class="cv-label">Nationality</div>
              <div class="cv-value" id="profileNationality">-</div>
            </div>
          </div>
        </div>
        <div class="cv-section">
          <h3><i class="fas fa-globe"></i> Training Details</h3>
          <div class="cv-row">
            <div class="cv-item">
              <div class="cv-label">Rank</div>
              <div class="cv-value" id="profileRank">-</div>
            </div>
            <div class="cv-item">
              <div class="cv-label">Roll/Section</div>
              <div class="cv-value" id="profileRollSec">-</div>
            </div>
            <div class="cv-item">
              <div class="cv-label">Batch</div>
              <div class="cv-value" id="profileBatch">-</div>
            </div>
            <div class="cv-item">
              <div class="cv-label">Shift</div>
              <div class="cv-value" id="profileShift">-</div>
            </div>
          </div>
        </div>
        <div class="cv-section">
          <h3><i class="fas fa-clock"></i> Real-Time Status</h3>
          <div class="real-time-status">
            <div class="status-item">
              <i class="status-indicator"></i>
              <i class="fas fa-user-check"></i>
              <p>Online</p>
            </div>
            <div class="status-item">
              <i class="status-indicator"></i>
              <p id="attendance-status">Checking attendance...</p>
            </div>
            <div class="status-item">
              <i class="status-indicator"></i>
              <p id="last-sync">Last sync: --</p>
            </div>
          </div>
          <div class="last-updated" id="lastUpdated">
            <p>Last updated: Checking...</p>
          </div>
        </div>
      </div>
    </div>
    <button onclick="logout()" class="logout-btn"><i class="fas fa-sign-out-alt"></i> Logout</button>
  </div>
  <script>
    function logout() {
      localStorage.removeItem('bmarpc_cadet_token');
      window.location.href = 'login.html';
    }
    function updateTime() {
      const now = new Date();
      document.getElementById('last-sync').textContent = 'Last sync: ' + now.toLocaleTimeString();
    }
    setInterval(updateTime, 1000);
    const saved = localStorage.getItem('bmarpc_cadet_token');
    if (saved) {
      const cadet = JSON.parse(saved).cadet;
      document.getElementById('profileBadge').innerHTML = '<i class="fas fa-star"></i> ' + cadet.rank;
      document.getElementById('profileName').textContent = cadet.name;
      document.getElementById('profileCadetNo').textContent = cadet.cadetNo;
      document.getElementById('profileRollSec').textContent = cadet.rollSec || 'N/A';
      document.getElementById('profileBatch').textContent = cadet.batch || 'N/A';
      document.getElementById('profileShift').textContent = cadet.shift;
      document.getElementById('profileNationality').textContent = cadet.nationality;
      document.getElementById('profileSex').textContent = cadet.sex;
      document.getElementById('profileRank').textContent = cadet.rank;
      document.getElementById('lastUpdated').innerHTML = '<p>Last updated: ' + new Date().toLocaleString() + '</p>';
      if (cadet.attendance && cadet.attendance.length > 0) {
        const latest = cadet.attendance[cadet.attendance.length - 1];
        document.getElementById('attendance-status').innerHTML = '<i class="fas fa-user-' + (latest.status === 'Present' ? 'check-circle' : 'times-circle') + '"></i> ' + latest.status;
      }
      if (cadet.photoUrl) {
        const photoEl = document.getElementById('profilePhoto');
        photoEl.src = cadet.photoUrl;
        photoEl.style.display = 'block';
      } else {
        document.getElementById('profilePhotoSection').innerHTML = '<div style="width:140px; height:140px; border:4px solid var(--accent); border-radius:50%; background:linear-gradient(135deg, var(--accent), var(--accent-dark)); display:flex; align-items:center; justify-content:center; margin:0 auto;"><i class="fas fa-user" style="font-size:60px; color:var(--white); opacity:0.8;"></i></div>';
      }
    } else {
      window.location.href = 'login.html';
    }
  </script>
</body>
</html>